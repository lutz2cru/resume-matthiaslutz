---
/**
 * Icônes de l'interface : un seul jeu, trait de 1,6 px sur une grille de 16, extrémités carrées
 * (cohérent avec les angles droits du site). Toujours décoratives : le texte voisin porte le sens.
 */
interface Props {
  name: 'arrow' | 'back' | 'ext' | 'up' | 'search' | 'check' | 'mail';
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class:list={['icon', `icon--${name}`, className]} viewBox="0 0 16 16" stroke-width="1.6" stroke-linecap="square" aria-hidden="true" focusable="false">
  {name === 'arrow' && <path d="M2.5 8h10M9 4.5 12.5 8 9 11.5" />}
  {name === 'back' && <path d="M13.5 8h-10M7 4.5 3.5 8 7 11.5" />}
  {name === 'ext' && <path d="M5 11 11 5M6 4.5h5.5V10" />}
  {name === 'up' && <path d="M8 13.5v-10M4.5 7 8 3.5 11.5 7" />}
  {name === 'search' && <><circle cx="7" cy="7" r="4.4" /><path d="m10.4 10.4 3.1 3.1" /></>}
  {name === 'check' && <path d="m3 8.5 3.2 3L13 4.5" />}
  {name === 'mail' && <><path d="M2.5 4h11v8h-11z" /><path d="m2.5 4.5 5.5 4.2 5.5-4.2" /></>}
</svg>
