---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import ExternalLink from '~/components/ui/ExternalLink.astro';
import Todo from '~/components/ui/Todo.astro';
import Icon from '~/components/ui/Icon.astro';
import Constellation from '~/components/blocks/Constellation.astro';
import ErasmusMap from '~/components/blocks/ErasmusMap.astro';
import GoalFrame from '~/components/blocks/GoalFrame.astro';
import { t, pageTitle } from '~/i18n/ui';
import { anchor, otherLang, path, type Lang } from '~/i18n/routes';
import { getProfile, pick } from '~/lib/content';
import { formatMonth } from '~/lib/format';
import nyhavn from '~/assets/images/nyhavn-copenhague.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const profile = await getProfile();
const hb = profile.handball;
const ph = profile.photography;
const er = profile.erasmus;
const [lead, ...rest] = ph.shots;
---

<Base lang={lang} page="beyond" title={pageTitle(lang, 'beyond')} description={t(lang, 'desc.beyond')} alternate={path(otherLang(lang), 'beyond')}>
  <PageHeader page="beyond" title={pageTitle(lang, 'beyond')} lead={t(lang, 'page.beyond.lead')} seed="beyond">
    <nav class="section-nav" aria-label={t(lang, 'beyond.sections')}>
      <ul role="list">
        <li><a href={`#${anchor(lang, 'photographie')}`}>{t(lang, 'beyond.photo')}</a></li>
        <li><a href={`#${anchor(lang, 'handball')}`}>{t(lang, 'beyond.handball')}</a></li>
        <li><a href={`#${anchor(lang, 'voyages')}`}>{t(lang, 'beyond.travel')}</a></li>
      </ul>
    </nav>
  </PageHeader>

  <!-- Photographie -->
  <section class="section" id={anchor(lang, 'photographie')} aria-labelledby="ph-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <h2 id="ph-title" class="h2">{t(lang, 'beyond.photo')}</h2>
      </header>
      <div class="ph-intro" data-reveal>
        <p class="lead">{pick(lang, ph.lead)}</p>
        <a class="btn" href={profile.links.photomatton} target="_blank" rel="noopener">
          {t(lang, 'beyond.galleries')}
          <Icon name="ext" />
          <span class="sr-only"> {t(lang, 'external')}</span>
        </a>
      </div>
      <figure class="gallery" data-reveal>
        <ul class="shots" role="list">
          {
            lead && (
              <li class="shot shot--lead">
                <img src={lead.src} alt={pick(lang, lead.alt)} width="800" height="534" loading="lazy" decoding="async" />
              </li>
            )
          }
          {
            rest.map((s) => (
              <li class="shot">
                <img src={s.src} alt={pick(lang, s.alt)} width="800" height="534" loading="lazy" decoding="async" />
              </li>
            ))
          }
        </ul>
        <figcaption class="cap">
          <span class="label label--strong">{pick(lang, ph.album)}</span>
          <span class="label">{pick(lang, ph.albumMeta)}</span>
        </figcaption>
      </figure>
      <Todo text={ph.todo} />
    </div>
  </section>

  <!-- Handball -->
  <section class="section" id={anchor(lang, 'handball')} aria-labelledby="hb-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <h2 id="hb-title" class="h2">{t(lang, 'beyond.handball')}</h2>
      </header>
      <div class="hb">
        <div class="hb-goal" data-reveal>
          <GoalFrame>
            <p class="hb-quote">{pick(lang, hb.quote)}</p>
          </GoalFrame>
          <Todo text={hb.todo} />
        </div>
        <div class="hb-text" data-reveal>
          <div class="prose">
            {hb.text.map((p) => <p>{pick(lang, p)}</p>)}
          </div>
          <dl class="specs">
            <div><dt class="label">{lang === 'fr' ? 'Poste' : 'Position'}</dt><dd>{pick(lang, hb.position)}</dd></div>
            <div><dt class="label">{lang === 'fr' ? 'Niveau' : 'Level'}</dt><dd>{hb.level}</dd></div>
            <div><dt class="label">Club</dt><dd>{hb.club}</dd></div>
            <div><dt class="label">{lang === 'fr' ? 'Parcours' : 'Background'}</dt><dd>{pick(lang, hb.background)}</dd></div>
            <div><dt class="label">{t(lang, 'beyond.press')}</dt><dd>L'Est Républicain, {formatMonth(lang, hb.pressDate.slice(0, 7))}</dd></div>
          </dl>
          <ExternalLink lang={lang} href={hb.press.href}>{pick(lang, hb.press.label)}</ExternalLink>
        </div>
      </div>
    </div>
  </section>

  <!-- Erasmus & voyages -->
  <section class="section" id={anchor(lang, 'voyages')} aria-labelledby="tr-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <h2 id="tr-title" class="h2">{t(lang, 'beyond.travel')}</h2>
      </header>
      <div class="tr-top" data-reveal>
        <div class="tr-text">
          <p class="lead">{pick(lang, er.lead)}</p>
          <p class="prose">{pick(lang, er.text)}</p>
          <ExternalLink lang={lang} href={profile.links.polarsteps}>{t(lang, 'beyond.polarsteps')}</ExternalLink>
          <Todo text={er.todo} />
        </div>
        <ul class="stats" role="list">
          <li><b>{er.cities}</b><span class="label">{t(lang, 'beyond.cities')}</span></li>
          <li><b>{er.countries}</b><span class="label">{t(lang, 'beyond.countries')}</span></li>
        </ul>
      </div>
      <div class="tr-tiles">
        <figure class="postcard" data-reveal>
          <Image
            src={nyhavn}
            alt={lang === 'fr' ? 'Les façades colorées et les bateaux du port de Nyhavn, à Copenhague, sous un ciel bleu' : 'The colourful façades and boats of Nyhavn harbour in Copenhagen, under a blue sky'}
            widths={[480, 720, 960]}
            sizes="(min-width: 900px) 34vw, 92vw"
            loading="lazy"
          />
          <figcaption class="label">{lang === 'fr' ? 'Nyhavn, Copenhague' : 'Nyhavn, Copenhagen'}</figcaption>
        </figure>
        <div data-reveal>
          <ErasmusMap lang={lang} caption={pick(lang, er.period)} />
        </div>
      </div>
    </div>
  </section>
  <section class="section" aria-labelledby="const-title">
    <div class="wrap">
      <h2 id="const-title" class="h2 sec-title" data-reveal>{t(lang, 'beyond.constellation')}</h2>
      <Constellation lang={lang} />
    </div>
  </section>

</Base>

<style>
  .sec-title,
  .sec-head {
    margin-bottom: clamp(32px, 5vw, 64px);
  }

  /* handball */
  .hb {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s-7);
    align-items: start;
  }

  .hb-quote {
    max-width: 18ch;
    font-size: clamp(1.5rem, 0.9rem + 2.6vw, 3.25rem);
    font-stretch: 120%;
    font-weight: 720;
    letter-spacing: -0.03em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .hb-text {
    display: grid;
    gap: var(--s-6);
  }

  .specs {
    border-top: 1px solid var(--c-line);
  }

  .specs div {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding: 12px 0;
    border-bottom: 1px solid var(--c-line);
  }

  .specs dd {
    text-align: right;
    font-size: var(--fs-small);
  }

  /* photographie */
  .ph-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-5);
    align-items: end;
    margin-bottom: var(--s-7);
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
  }

  .shot {
    overflow: hidden;
    background: var(--c-surface);
  }

  .shot--lead {
    grid-column: span 2;
    grid-row: span 2;
  }

  .shot img {
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .shot:hover img {
    transform: scale(1.04);
  }

  .cap {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    margin-top: var(--s-3);
  }

  /* voyages */
  .tr-top {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s-7);
    align-items: end;
    margin-bottom: var(--s-7);
  }

  .tr-text {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--c-line);
  }

  .stats li {
    display: grid;
    gap: 4px;
    padding-top: var(--s-4);
  }

  .stats b {
    color: var(--c-text);
    font-size: clamp(3rem, 2rem + 4vw, 5.5rem);
    font-stretch: 125%;
    font-weight: 760;
    letter-spacing: -0.04em;
    line-height: 0.9;
  }

  .tr-tiles {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-5);
    align-items: stretch;
  }

  .postcard {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--s-3);
  }

  .postcard :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid var(--c-line);
  }

  @media (max-width: 900px) {
    .hb,
    .tr-top,
    .tr-tiles,
    .ph-intro {
      grid-template-columns: 1fr;
    }

    .ph-intro {
      justify-items: start;
    }

    .postcard :global(img) {
      aspect-ratio: 4 / 5;
    }
  }

  @media (max-width: 560px) {
    .shots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
