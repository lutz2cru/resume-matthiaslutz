---
/**
 * La page unique : en-tête de profil, puis Expériences, Formations, Compétences, Handball.
 * Même structure en français et en anglais ; tout le texte vient de src/content/ et src/i18n/ui.ts.
 */
import Base from '~/layouts/Base.astro';
import ExternalLink from '~/components/ui/ExternalLink.astro';
import Todo from '~/components/ui/Todo.astro';
import { t } from '~/i18n/ui';
import { ANCHORS, HOME, otherLang, type Lang, type Section } from '~/i18n/routes';
import { getJourney, getPlaceNames, getProfile, getSkillGroups, pick, type JourneyEntry } from '~/lib/content';
import { formatDay, formatPeriod } from '~/lib/format';
import { personJsonLd } from '~/lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const profile = await getProfile();
const journey = await getJourney();
const skillGroups = await getSkillGroups(lang);
const places = await getPlaceNames();
const hb = profile.handball;

const id = (section: Section) => ANCHORS[section][lang];
const heading = (section: Section) => `${id(section)}-title`;
const where = (entry: JourneyEntry) => [entry.data.org, entry.data.place && pick(lang, places.get(entry.data.place))].filter(Boolean).join(' · ');

const timeline: { section: Section; entries: JourneyEntry[] }[] = [
  { section: 'experience', entries: journey.experience },
  { section: 'education', entries: journey.education },
];
---

<Base
  lang={lang}
  title={`${profile.name} — ${pick(lang, profile.role)}`}
  description={t(lang, 'desc.home')}
  alternate={HOME[otherLang(lang)]}
  jsonLd={personJsonLd(lang, profile)}
>
  <!-- Profil -->
  <header class="wrap intro">
    <h1 class="name">{profile.name}</h1>
    <p class="lede">{pick(lang, profile.tagline)}</p>
    <ul class="contact" aria-label={t(lang, 'contact.title')}>
      <li><a class="link" href={`mailto:${profile.email}`}>{profile.email}</a></li>
      <li><ExternalLink lang={lang} href={profile.links.linkedin}>LinkedIn</ExternalLink></li>
      <li><ExternalLink lang={lang} href={profile.links.github}>GitHub</ExternalLink></li>
      <li><ExternalLink lang={lang} href={profile.links.cv[lang]}>{t(lang, 'contact.cv')}</ExternalLink></li>
    </ul>
    <dl class="facts">
      {
        profile.facts.map((fact) => (
          <div class="fact">
            <dt class="label">{pick(lang, fact.label)}</dt>
            <dd class="fact-value">{pick(lang, fact.value)}</dd>
            {fact.detail && <dd class="fact-detail">{pick(lang, fact.detail)}</dd>}
          </div>
        ))
      }
    </dl>
  </header>

  <!-- Expériences, puis Formations -->
  {
    timeline.map(({ section, entries }, i) => (
      <section class="wrap section" id={id(section)} aria-labelledby={heading(section)}>
        <div class="section-head">
          <span class="section-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h2 id={heading(section)}>{t(lang, `section.${section}` as const)}</h2>
        </div>
        <ol class="entries">
          {entries.map((entry) => (
            <li class="entry">
              <p class="entry-when">
                {formatPeriod(lang, entry.data)}
                {entry.data.current && <span class="now">{t(lang, 'journey.now')}</span>}
              </p>
              <div class="entry-body">
                <h3 class="entry-title">{pick(lang, entry.data.title)}</h3>
                <p class="entry-where">{where(entry)}</p>
                <p class="entry-text">{pick(lang, entry.data.description)}</p>
                {entry.data.points && (
                  <ul class="entry-points">
                    {entry.data.points.map((point) => (
                      <li>{pick(lang, point)}</li>
                    ))}
                  </ul>
                )}
                {entry.data.tags.length > 0 && <p class="entry-tags">{entry.data.tags.map((tag) => pick(lang, tag)).join(' · ')}</p>}
                {entry.data.links.length > 0 && (
                  <ul class="entry-links">
                    {entry.data.links.map((l) => (
                      <li>
                        <ExternalLink lang={lang} href={l.href} hreflang="fr">
                          {pick(lang, l.label)}
                        </ExternalLink>
                      </li>
                    ))}
                  </ul>
                )}
                <Todo text={entry.data.todo} />
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  <!-- Compétences -->
  <section class="wrap section" id={id('skills')} aria-labelledby={heading('skills')}>
    <div class="section-head">
      <span class="section-no" aria-hidden="true">03</span>
      <h2 id={heading('skills')}>{t(lang, 'section.skills')}</h2>
    </div>
    <div class="skills">
      <p class="legend">
        <span class="sr-only">{t(lang, 'skills.legend')} : </span>
        <span class="lvl lvl--solid">{t(lang, 'skills.level.solid')}</span>
        <span class="lvl lvl--learning">{t(lang, 'skills.level.learning')}</span>
      </p>
      <div class="skill-grid">
        {
          skillGroups.map(({ group, skills }) => (
            <div class="skill-group">
              <h3 class="label">{t(lang, `group.${group}` as const)}</h3>
              <ul>
                {skills.map((skill) => (
                  <li class:list={['skill', skill.data.level && `lvl lvl--${skill.data.level}`]}>
                    {pick(lang, skill.data.label)}
                    {skill.data.level && <span class="sr-only"> ({t(lang, `skills.level.${skill.data.level}` as const)})</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div class="skill-group">
          <h3 class="label">{t(lang, 'skills.languages')}</h3>
          <ul>
            {
              profile.languages.map((language) => (
                <li class="skill">
                  {pick(lang, language.label)} <span class="skill-note">— {pick(lang, language.level)}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Handball -->
  <section class="wrap section" id={id('handball')} aria-labelledby={heading('handball')}>
    <div class="section-head">
      <span class="section-no" aria-hidden="true">04</span>
      <h2 id={heading('handball')}>{t(lang, 'section.handball')}</h2>
    </div>
    <div class="handball">
      <p class="quote">{pick(lang, hb.quote)}</p>
      <dl class="hb-facts">
        <div>
          <dt class="label">{t(lang, 'handball.position')}</dt>
          <dd>{pick(lang, hb.position)}</dd>
        </div>
        <div>
          <dt class="label">{t(lang, 'handball.club')}</dt>
          <dd>{hb.club}</dd>
        </div>
        <div>
          <dt class="label">{t(lang, 'handball.level')}</dt>
          <dd>{hb.level}<span class="hb-note">{pick(lang, hb.division)}</span></dd>
        </div>
        <div>
          <dt class="label">{t(lang, 'handball.background')}</dt>
          <dd>{pick(lang, hb.background)}</dd>
        </div>
      </dl>
      <div class="hb-text">
        {hb.text.map((paragraph) => <p>{pick(lang, paragraph)}</p>)}
      </div>
      <p class="hb-press">
        <span class="label">{t(lang, 'handball.press')}</span>
        <ExternalLink lang={lang} href={hb.press.href} hreflang="fr">{pick(lang, hb.press.label)}</ExternalLink>
        <time datetime={hb.pressDate}>{formatDay(lang, hb.pressDate)}</time>
      </p>
      <Todo text={hb.todo} />
    </div>
  </section>
</Base>

<style>
  /* ---------- profil */
  .intro {
    display: grid;
    gap: var(--s-5);
    padding-block: var(--s-9) var(--s-8);
  }

  .name {
    font-size: var(--fs-display);
    font-weight: 700;
    font-stretch: 92%;
    line-height: 0.92;
    letter-spacing: -0.04em;
  }

  .lede {
    max-width: 40ch;
    font-size: var(--fs-lede);
    line-height: 1.45;
    color: var(--c-text-2);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-5);
  }

  .contact :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .facts {
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-6);
    padding-top: var(--s-5);
    border-top: 1px solid var(--c-text);
  }

  .fact {
    display: grid;
    gap: var(--s-1);
    align-content: start;
  }

  .fact-value {
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.3;
  }

  .fact-detail {
    font-size: var(--fs-meta);
    color: var(--c-text-2);
  }

  @media (min-width: 720px) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-6);
    }
  }

  /* ---------- rubriques */
  .section {
    display: grid;
    gap: var(--s-6);
    padding-top: var(--s-8);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    padding-top: var(--s-4);
    border-top: 1px solid var(--c-text);
  }

  .section-head h2 {
    font-size: var(--fs-h2);
    letter-spacing: -0.025em;
  }

  .section-no {
    font-size: var(--fs-meta);
    font-weight: 600;
    color: var(--c-accent);
  }

  @media (min-width: 960px) {
    .section {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      column-gap: var(--s-7);
      padding-top: var(--s-9);
    }

    .section-head {
      flex-direction: column;
      gap: var(--s-2);
      align-self: start;
      position: sticky;
      top: calc(var(--header-h) + var(--s-5));
    }

    /* Le contenu de chaque rubrique s'ouvre sur le même filet que son titre. */
    .entries,
    .skills,
    .handball {
      border-top: 1px solid var(--c-text);
    }
  }

  /* ---------- entrées du parcours */

  .entry {
    display: grid;
    gap: var(--s-2);
    padding-block: var(--s-5) var(--s-6);
    border-bottom: 1px solid var(--c-line);
  }

  .entry:last-child {
    border-bottom: 0;
  }

  .entry-when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-meta);
    color: var(--c-text-3);
  }

  .now {
    padding: 2px var(--s-2);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-accent);
    background: var(--c-accent-soft);
    border-radius: 2px;
  }

  .entry-body {
    display: grid;
    gap: var(--s-2);
    max-width: var(--measure);
  }

  .entry-title {
    font-size: var(--fs-h3);
    font-weight: 650;
    line-height: 1.3;
  }

  .entry-where {
    color: var(--c-text-2);
    font-weight: 500;
  }

  .entry-text {
    margin-top: var(--s-1);
    color: var(--c-text-2);
  }

  .entry-points {
    display: grid;
    gap: var(--s-1);
    color: var(--c-text-2);
  }

  .entry-points li {
    position: relative;
    padding-left: var(--s-5);
  }

  .entry-points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.8em;
    width: 10px;
    height: 1px;
    background: var(--c-text-3);
  }

  .entry-tags {
    font-size: var(--fs-meta);
    color: var(--c-text-3);
  }

  .entry-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-5);
  }

  .entry-links :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  @media (min-width: 640px) {
    .entry {
      grid-template-columns: 11rem minmax(0, 1fr);
      column-gap: var(--s-6);
    }

    .entry-when {
      align-self: start;
      flex-direction: column;
      align-items: flex-start;
      padding-top: 3px;
    }
  }

  /* ---------- compétences */
  .skills {
    display: grid;
    gap: var(--s-5);
    padding-top: var(--s-4);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    font-size: var(--fs-meta);
    color: var(--c-text-2);
  }

  .skill-grid {
    display: grid;
    gap: var(--s-6) var(--s-6);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }

  .skill-group {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }

  .skill-group ul {
    display: grid;
    gap: var(--s-1);
  }

  .skill {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
  }

  .skill-note {
    color: var(--c-text-3);
  }

  /* Repère de niveau : disque plein = pratiqué, anneau = en apprentissage. */
  .lvl {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-2);
  }

  .lvl::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid var(--c-accent);
    transform: translateY(-1px);
  }

  .lvl--solid::before {
    background: var(--c-accent);
  }

  .skill:not(.lvl) {
    padding-left: calc(8px + var(--s-2));
  }

  /* ---------- handball */
  .handball {
    display: grid;
    gap: var(--s-6);
    padding-top: var(--s-5);
  }

  .quote {
    max-width: 24ch;
    font-size: var(--fs-quote);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .hb-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
  }

  .hb-facts div {
    display: grid;
    gap: var(--s-1);
    align-content: start;
  }

  .hb-facts dd {
    display: grid;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.3;
  }

  .hb-note {
    font-size: var(--fs-meta);
    font-weight: 400;
    color: var(--c-text-2);
  }

  .hb-text {
    display: grid;
    gap: var(--s-4);
    max-width: var(--measure);
    color: var(--c-text-2);
  }

  .hb-press {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--c-line);
  }

  .hb-press :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .hb-press time {
    font-size: var(--fs-meta);
    color: var(--c-text-3);
  }

  @media (min-width: 720px) {
    .hb-facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
