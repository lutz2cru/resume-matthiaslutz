---
/** Lien sortant : nouvel onglet, rel sûr, flèche décorative, mention pour les lecteurs d'écran. */
import Icon from './Icon.astro';
import { t } from '~/i18n/ui';
import type { Lang } from '~/i18n/routes';

interface Props {
  lang: Lang;
  href: string;
  class?: string;
  hreflang?: string;
}

const { lang, href, class: className, hreflang } = Astro.props;
---

<a class:list={['link', className]} href={href} target="_blank" rel="noopener" hreflang={hreflang}><slot /><Icon name="ext" /><span class="sr-only"> {t(lang, 'external')}</span></a>
