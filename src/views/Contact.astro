---
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import { t, pageTitle } from '~/i18n/ui';
import { otherLang, path, type Lang } from '~/i18n/routes';
import { getProfile, pick } from '~/lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const profile = await getProfile();
const channels = [
  { k: 'LinkedIn', v: 'matthias-lutz1', href: profile.links.linkedin },
  { k: 'GitHub', v: 'lutz2cru', href: profile.links.github },
  { k: lang === 'fr' ? 'CV' : 'Résumé', v: 'cvdesignr.com', href: pick(lang, profile.links.cv) },
  { k: "Photomatt'on", v: lang === 'fr' ? 'photos de sport' : 'sports photos', href: profile.links.photomatton },
  { k: 'Polarsteps', v: 'lutz2cru', href: profile.links.polarsteps },
];
---

<Base lang={lang} page="contact" title={pageTitle(lang, 'contact')} description={t(lang, 'desc.contact')} alternate={path(otherLang(lang), 'contact')}>
  <PageHeader index={6} title={pageTitle(lang, 'contact')} lead={t(lang, 'page.contact.lead')} seed="contact" />

  <section class="section">
    <div class="wrap">
      <div class="mailbox" data-reveal>
        <p class="label">{t(lang, 'contact.title')}</p>
        <a class="mail" href={`mailto:${profile.email}`}>{profile.email}</a>
        <div class="row">
          <a class="btn" href={`mailto:${profile.email}`}>{lang === 'fr' ? 'Écrire un e-mail' : 'Write an email'} <span aria-hidden="true">→</span></a>
          <button type="button" class="btn btn--ghost copy" data-copy={profile.email} data-copied={t(lang, 'contact.copied')} data-requires-js>
            <span class="c-idle">{t(lang, 'contact.copy')}</span><span class="c-done" aria-hidden="true">✓</span>
          </button>
          <span class="label" role="status" aria-live="polite" data-copy-status></span>
        </div>
        <p class="note">{t(lang, 'contact.noform')}</p>
      </div>

      <section class="elsewhere" aria-labelledby="else-title">
        <h2 id="else-title" class="label">{t(lang, 'contact.elsewhere')}</h2>
        <ul role="list" data-reveal-group>
          {
            channels.map((c) => (
              <li data-reveal>
                <a href={c.href} target="_blank" rel="noopener">
                  <span class="ch">{c.k}</span>
                  <span class="handle">{c.v}</span>
                  <span class="go" aria-hidden="true">↗</span>
                  <span class="sr-only"> {t(lang, 'external')}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </section>
</Base>

<style>
  .mailbox {
    display: grid;
    gap: var(--s-5);
    padding-bottom: var(--s-8);
    border-bottom: 1px solid var(--c-line);
  }

  .mail {
    width: fit-content;
    max-width: 100%;
    font-size: clamp(2rem, 0.8rem + 6vw, 7rem);
    font-stretch: 125%;
    font-weight: 760;
    letter-spacing: -0.045em;
    line-height: 0.95;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--dur-1) var(--ease-out);
  }

  .mail:hover {
    color: var(--c-accent);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }

  .copy .c-done {
    display: none;
  }

  .copy:global(.is-done) .c-done {
    display: inline;
  }

  .note {
    color: var(--c-text-3);
    font-size: var(--fs-small);
  }

  .elsewhere {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: var(--s-5);
    padding-top: var(--s-7);
  }

  .elsewhere ul {
    border-top: 1px solid var(--c-line);
  }

  .elsewhere li {
    border-bottom: 1px solid var(--c-line);
  }

  .elsewhere a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 28px;
    gap: var(--s-4);
    align-items: baseline;
    padding: 20px 0;
    text-decoration: none;
  }

  .ch {
    font-size: clamp(1.375rem, 1rem + 1.6vw, 2.25rem);
    font-stretch: 118%;
    font-weight: 680;
    letter-spacing: -0.025em;
    transition:
      color var(--dur-1) var(--ease-out),
      font-stretch var(--dur-3) var(--ease-out);
  }

  .handle {
    font-family: var(--f-mono);
    font-size: var(--fs-mono-l);
    color: var(--c-text-3);
  }

  .go {
    color: var(--c-text-3);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .elsewhere a:hover .ch {
    color: var(--c-accent);
    font-stretch: 125%;
  }

  .elsewhere a:hover .go {
    color: var(--c-accent);
    transform: translate(3px, -3px);
  }

  @media (max-width: 760px) {
    .elsewhere {
      grid-template-columns: 1fr;
    }

    .elsewhere a {
      grid-template-columns: minmax(0, 1fr) 20px;
    }

    .handle {
      grid-column: 1;
      grid-row: 2;
    }

    .go {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
