---
/** Caisse Noire reconstituée en HTML/CSS (données d'exemple). Couleur or : identité de l'application. */
---

<div class="phone" aria-hidden="true">
  <div class="screen">
    <div class="top"><img src="https://caisse-noire-mu.vercel.app/icon.svg" alt="" width="28" height="28" loading="lazy" />Caisse <em>Noire</em></div>
    <div class="card total"><span class="lbl">En caisse</span><b>248,50 €</b></div>
    <span class="lbl">Gros payeurs</span>
    <ol class="rank">
      <li><span class="pos">1</span><span class="av">CA</span><span class="nm">Le capitaine</span><b>32 €</b></li>
      <li><span class="pos">2</span><span class="av">AI</span><span class="nm">L'ailier gauche</span><b>21 €</b></li>
      <li><span class="pos">3</span><span class="av">PI</span><span class="nm">Le pivot</span><b>17 €</b></li>
      <li><span class="pos">4</span><span class="av">GB</span><span class="nm">Le gardien</span><b>4 €</b></li>
    </ol>
    <div class="card court">
      <span class="lbl">Tribunal</span>
      <p>« Retard à l'entraînement » — amende contestée</p>
      <div class="vote"><span></span></div>
      <div class="vote-l"><span>Coupable 64 %</span><span>Acquitté 36 %</span></div>
    </div>
    <div class="tabbar"><i class="on"></i><i></i><i></i><i></i></div>
  </div>
</div>

<style>
  .phone {
    --gold: #f4c542;
    width: min(300px, 78vw);
    margin-inline: auto;
    padding: 10px;
    background: #050608;
    border: 1px solid var(--c-line);
    border-radius: 38px;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.45);
  }

  .screen {
    display: grid;
    gap: 10px;
    padding: 18px 14px 12px;
    border-radius: 30px;
    background: #0e0e10;
    font-family: var(--f-sans);
    font-size: 12px;
    color: #f2f2f2;
  }

  .top {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    font-weight: 700;
    font-stretch: 110%;
  }

  .top em {
    font-style: normal;
    color: var(--gold);
  }

  .card {
    padding: 12px;
    border-radius: 14px;
    background: #18181b;
  }

  .total b {
    display: block;
    margin-top: 2px;
    font-size: 26px;
    font-stretch: 110%;
    color: var(--gold);
  }

  .lbl {
    font-family: var(--f-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #9b9ba3;
  }

  .rank {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .rank li {
    display: grid;
    grid-template-columns: 14px 26px 1fr auto;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 12px;
    background: #18181b;
  }

  .rank li:first-child {
    background: #2a2414;
  }

  .pos {
    color: #9b9ba3;
  }

  .av {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    font-size: 9px;
    background: #2a2a30;
  }

  .rank b {
    color: var(--gold);
  }

  .court p {
    margin: 6px 0 8px;
    line-height: 1.35;
  }

  .vote {
    height: 6px;
    border-radius: 3px;
    background: #2a2a30;
    overflow: hidden;
  }

  .vote span {
    display: block;
    width: 64%;
    height: 100%;
    background: var(--gold);
  }

  .vote-l {
    display: flex;
    justify-content: space-between;
    margin-top: 6px;
    font-size: 10px;
    color: #9b9ba3;
  }

  .tabbar {
    display: flex;
    justify-content: space-around;
    padding-top: 8px;
  }

  .tabbar i {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    background: #2a2a30;
  }

  .tabbar i.on {
    background: var(--gold);
  }
</style>
