---
/** En-tête de page : titre, chapeau, bandeau génératif ; numéro de planche dans l'angle (repère de carte). */
import Terrain from './Terrain.astro';
import Icon from './Icon.astro';
import { pad2 } from '~/lib/format';
import { TERRITORIES, territoryIndex, type PageKey } from '~/i18n/routes';

interface Props {
  /** Territoire de la page : donne le numéro de planche affiché dans l'angle. */
  page?: PageKey;
  /** Fil d'Ariane (fiches projet) : lien de retour vers la liste. */
  crumb?: { href: string; label: string; navLabel: string; position?: string };
  title: string;
  lead?: string;
  seed: string;
  /** Nom de transition de vue (titre partagé liste → fiche). */
  vtName?: string;
}

const { page, crumb, title, lead, seed, vtName } = Astro.props;
const index = page ? territoryIndex(page) : 0;
---

<header class="page-head">
  <Terrain id={`terrain-${seed}`} variant="band" seed={seed} />
  <div class="wrap inner">
    {
      crumb && (
        <nav class="crumb" aria-label={crumb.navLabel}>
          <a class="link" href={crumb.href}>
            <span class="arrow arrow--back">
              <Icon name="back" />
            </span>
            {crumb.label}
          </a>
          {crumb.position && <span class="label">{crumb.position}</span>}
        </nav>
      )
    }
    <h1 class="h1 title" style={vtName ? `view-transition-name: ${vtName}` : undefined}>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
  {
    index > 0 && (
      <span class="plate label" aria-hidden="true">
        <b>{pad2(index)}</b> / {pad2(TERRITORIES.length)}
      </span>
    )
  }
  <span class="mark mark--tl" aria-hidden="true"></span>
  <span class="mark mark--tr" aria-hidden="true"></span>
</header>

<style>
  .page-head {
    position: relative;
    isolation: isolate;
    padding-top: clamp(64px, 9vw, 136px);
    padding-bottom: clamp(48px, 6vw, 88px);
    border-bottom: 1px solid var(--c-line-soft);
    overflow: hidden;
  }

  .inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-5);
  }

  .crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin-bottom: var(--s-3);
    font-size: var(--fs-small);
  }

  .crumb .link {
    color: var(--c-text-2);
  }

  .crumb .link:hover {
    color: var(--c-accent);
  }

  .title {
    max-width: 18ch;
  }

  .lead {
    max-width: 52ch;
  }

  .plate {
    position: absolute;
    top: 20px;
    right: calc(var(--gutter) + 22px);
    color: var(--c-text-3);
  }

  .plate b {
    font-weight: 500;
    color: var(--c-tech);
  }

  .mark {
    position: absolute;
    width: 14px;
    height: 14px;
    top: 24px;
    pointer-events: none;
  }

  .mark::before,
  .mark::after {
    content: '';
    position: absolute;
    background: var(--c-text-3);
  }

  .mark::before {
    left: 6px;
    top: 0;
    width: 1px;
    height: 14px;
  }

  .mark::after {
    top: 6px;
    left: 0;
    width: 14px;
    height: 1px;
  }

  .mark--tl {
    left: calc(var(--gutter) - 7px);
  }

  .mark--tr {
    right: calc(var(--gutter) - 7px);
  }
</style>
