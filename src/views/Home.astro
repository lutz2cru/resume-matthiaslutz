---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Terrain from '~/components/ui/Terrain.astro';
import NowList from '~/components/blocks/NowList.astro';
import GoalFrame from '~/components/blocks/GoalFrame.astro';
import ExternalLink from '~/components/ui/ExternalLink.astro';
import ProjectThumb from '~/components/ui/ProjectThumb.astro';
import Icon from '~/components/ui/Icon.astro';
import { t, pageTitle, type UIKey } from '~/i18n/ui';
import { TERRITORIES, anchor, otherLang, path, projectPath, type Lang } from '~/i18n/routes';
import { getCases, getJourney, getPlaces, getProfile, getProjects, getSkills, pick } from '~/lib/content';
import { formatCoord, formatPeriod, formatUpdated, pad2 } from '~/lib/format';
import { personJsonLd } from '~/lib/seo';
import nyhavn from '~/assets/images/nyhavn-copenhague.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const other = otherLang(lang);
const profile = await getProfile();
const projects = await getProjects();
const cases = await getCases();
const featured = cases.filter((p) => p.data.featured).slice(0, 4);
const fullJourney = await getJourney();
const journey = fullJourney.filter((j) => j.data.type !== 'sport').slice(0, 4);
const skills = await getSkills();
const skillLabel = new Map(skills.map((s) => [s.id, s.data.label[lang]]));
const places = await getPlaces();
const dijon = places.get('dijon');

const counts: Record<string, string> = {
  about: t(lang, 'territory.about'),
  projects: `${projects.length} ${t(lang, 'territory.projects')}`,
  journey: `${fullJourney.length} ${t(lang, 'territory.journey')}`,
  skills: `${skills.length} ${t(lang, 'territory.skills')}`,
  beyond: t(lang, 'territory.beyond'),
  contact: t(lang, 'territory.contact'),
};
const firstShot = profile.photography.shots[0]!;
---

<Base lang={lang} page="home" title={profile.name} description={pick(lang, profile.tagline)} alternate={path(other, 'home')} jsonLd={personJsonLd(lang, profile)}>
  <section class="hero" aria-labelledby="hero-title">
    <Terrain id="terrain-hero" variant="hero" seed="tulz-home" />
    <div class="wrap hero-grid">
      <p class="label coords" aria-hidden="true">
        {dijon && <span>{formatCoord(dijon.lat, dijon.lon)} · {pick(lang, dijon.name)}</span>}
        <span class="readout" data-terrain-readout="terrain-hero">x 000 · y 000 · z 000</span>
      </p>

      <div class="hero-main">
        <h1 id="hero-title" class="hero-name">
          <span class="line">Matthias</span>
          <span class="line">Lutz</span>
        </h1>
        <p class="hero-role">{pick(lang, profile.role)}</p>
        <dl class="highlights">
          {
            profile.highlights.map((h) => (
              <div>
                <dt class="label">{pick(lang, h.label)}</dt>
                <dd>
                  <span class="hl-value">{pick(lang, h.value)}</span>
                  {h.detail && <span class="hl-detail">{pick(lang, h.detail)}</span>}
                </dd>
              </div>
            ))
          }
        </dl>
        <div class="hero-cta">
          <a class="btn" href={path(lang, 'projects')}>
            {t(lang, 'home.explore')}
            <Icon name="arrow" />
          </a>
          <a class="btn btn--ghost" href={path(lang, 'journey')}>{t(lang, 'home.fullJourney')}</a>
          <span class="hint label" data-requires-js>
            {t(lang, 'home.palette')}
            <button type="button" class="kbd-btn" data-palette-open aria-haspopup="dialog" aria-controls="palette">
              <span class="kbd" data-kbd-mod>Ctrl</span><span class="kbd">K</span><span class="sr-only">{t(lang, 'palette.open')}</span>
            </button>
          </span>
        </div>
      </div>

      <nav class="legend" aria-labelledby="legend-title">
        <h2 id="legend-title" class="label">{t(lang, 'home.legend')}</h2>
        <ol role="list">
          {
            TERRITORIES.map((key, i) => (
              <li>
                <a href={path(lang, key)}>
                  <span class="idx" aria-hidden="true">{pad2(i + 1)}</span>
                  <span class="nm">{pageTitle(lang, key)}</span>
                  <span class="meta">{counts[key]}</span>
                  <span class="go">
                    <Icon name="arrow" />
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </section>

  <section class="section" aria-labelledby="now-title">
    <div class="wrap split">
      <header class="split-head" data-reveal>
        <h2 id="now-title" class="h2">{t(lang, 'home.now')}</h2>
        <p class="label">{t(lang, 'home.updated')} {formatUpdated(lang, profile.updated)}</p>
      </header>
      <NowList lang={lang} />
    </div>
  </section>

  <section class="section" aria-labelledby="selected-title">
    <div class="wrap">
      <header class="row-head" data-reveal>
        <h2 id="selected-title" class="h2">{t(lang, 'home.selected')}</h2>
        <a class="link" href={path(lang, 'projects')}>
          {t(lang, 'home.allProjects')} ({projects.length})
          <span class="arrow"><Icon name="arrow" /></span>
        </a>
      </header>
      <ul class="featured" role="list">
        {
          featured.map((p) => (
            <li class="feat" data-reveal>
              <a class="feat-thumb" href={projectPath(lang, p.id)} tabindex="-1" aria-hidden="true">
                <ProjectThumb project={p} sizes="(max-width: 760px) 100vw, 50vw" />
              </a>
              <div class="feat-body">
                <h3 class="feat-title">
                  <a href={projectPath(lang, p.id)} style={`view-transition-name: project-${p.id}`}>
                    {pick(lang, p.data.title)}
                  </a>
                </h3>
                {p.data.status && <span class={`pstatus pstatus--${p.data.status}`}>{t(lang, `status.${p.data.status}` as UIKey)}</span>}
                <p class="feat-summary">{pick(lang, p.data.summary)}</p>
                <p class="feat-stack">{[...p.data.stack.map((id) => skillLabel.get(id) ?? id), ...p.data.extra].slice(0, 4).join(' · ')}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="journey-title">
    <div class="wrap">
      <header class="row-head" data-reveal>
        <h2 id="journey-title" class="h2">{t(lang, 'home.journey')}</h2>
        <a class="link" href={path(lang, 'journey')}>
          {t(lang, 'home.fullJourney')}
          <span class="arrow"><Icon name="arrow" /></span>
        </a>
      </header>
      <ol class="steps" role="list" data-reveal-group>
        {
          journey.map((j) => {
            const place = j.data.place ? places.get(j.data.place) : undefined;
            return (
              <li class="step" data-reveal style={`--type: var(--c-type-${j.data.type})`}>
                <h3 class="step-title">
                  <a href={`${path(lang, 'journey')}#${j.id}`}>{pick(lang, j.data.title)}</a>
                </h3>
                <p class="step-org">
                  {j.data.org}
                  {place && <span> · {pick(lang, place.name)}</span>}
                </p>
                <p class="label step-date">
                  {j.data.current && <span class="dot" aria-hidden="true" />}
                  {formatPeriod(lang, j.data)}
                </p>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="beyond-title">
    <div class="wrap">
      <header class="row-head" data-reveal>
        <h2 id="beyond-title" class="h2">{t(lang, 'home.beyond')}</h2>
        <a class="link" href={path(lang, 'beyond')}>
          {pageTitle(lang, 'beyond')}
          <span class="arrow"><Icon name="arrow" /></span>
        </a>
      </header>
      <div class="beyond" data-reveal-group>
        <article class="b-item" data-reveal>
          <div class="b-media">
            <img src={firstShot.src} alt={pick(lang, firstShot.alt)} width="800" height="534" loading="lazy" decoding="async" />
          </div>
          <h3 class="h3">
            <a href={`${path(lang, 'beyond')}#${anchor(lang, 'photographie')}`}>
              {t(lang, 'beyond.photo')}
              <Icon name="arrow" />
            </a>
          </h3>
          <p class="b-text">{pick(lang, profile.photography.album)} — {pick(lang, profile.photography.albumMeta)}</p>
        </article>
        <article class="b-item" data-reveal>
          <GoalFrame compact>
            <p class="goal-quote">N3</p>
          </GoalFrame>
          <h3 class="h3">
            <a href={`${path(lang, 'beyond')}#${anchor(lang, 'handball')}`}>
              {t(lang, 'beyond.handball')}
              <Icon name="arrow" />
            </a>
          </h3>
          <p class="b-text">{pick(lang, profile.handball.quote)}</p>
        </article>
        <article class="b-item" data-reveal>
          <div class="b-media">
            <Image
              src={nyhavn}
              alt={lang === 'fr' ? 'Les façades colorées et les bateaux du port de Nyhavn, à Copenhague' : 'The colourful façades and boats of Nyhavn harbour, Copenhagen'}
              widths={[480, 800]}
              sizes="(min-width: 900px) 30vw, 90vw"
              loading="lazy"
            />
          </div>
          <h3 class="h3">
            <a href={`${path(lang, 'beyond')}#${anchor(lang, 'voyages')}`}>
              {t(lang, 'beyond.travel')}
              <Icon name="arrow" />
            </a>
          </h3>
          <p class="b-text">{pick(lang, profile.erasmus.period)}</p>
        </article>
      </div>
      <p class="beyond-foot">
        <ExternalLink lang={lang} href={profile.links.photomatton}>Photomatt'on</ExternalLink>
        <ExternalLink lang={lang} href={profile.links.polarsteps}>Polarsteps</ExternalLink>
      </p>
    </div>
  </section>
</Base>

<style>
  /* ---------- ouverture */
  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    border-bottom: 1px solid var(--c-line-soft);
    overflow: hidden;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
    grid-template-rows: auto 1fr;
    gap: var(--s-6) var(--s-8);
    padding-top: var(--s-5);
    padding-bottom: clamp(32px, 5vw, 64px);
  }

  .coords {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }

  .readout {
    min-width: 21ch;
    color: var(--c-text-2);
  }

  .hero-main {
    align-self: end;
    display: grid;
    gap: var(--s-5);
  }

  .hero-name {
    font-size: var(--fs-display);
    font-stretch: 125%;
    font-weight: 780;
    letter-spacing: -0.045em;
    line-height: 0.86;
    margin-left: -0.04em;
  }

  .hero-name .line {
    display: block;
  }

  :global(html.motion-ok) .hero-name .line {
    animation: rise 1.1s var(--ease-out) both;
  }

  :global(html.motion-ok) .hero-name .line + .line {
    animation-delay: 90ms;
  }

  /* Opacité et translation seulement : animer font-stretch relancerait la mise en page à chaque image. */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.25em);
    }
  }

  .hero-role {
    font-size: var(--fs-lead);
    font-stretch: 110%;
    font-weight: 600;
    line-height: 1.25;
    color: var(--c-accent);
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 920px;
    border-top: 1px solid var(--c-line);
  }

  .highlights > div {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: var(--s-4) var(--s-5) 0 0;
  }

  .highlights > div + div {
    padding-left: var(--s-5);
    border-left: 1px solid var(--c-line-soft);
  }

  .highlights dd {
    display: grid;
    gap: 4px;
  }

  .hl-value {
    font-weight: 600;
    font-stretch: 106%;
    line-height: 1.3;
    color: var(--c-text);
  }

  .hl-detail {
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--c-text-2);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-4);
    margin-top: var(--s-2);
  }

  .hint {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: var(--s-2);
  }

  .kbd-btn {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    min-height: var(--tap);
  }

  .kbd-btn:hover .kbd {
    color: var(--c-tech);
    border-color: var(--c-tech);
  }

  .legend {
    align-self: end;
    padding: var(--s-5);
    background: var(--c-overlay);
    border: 1px solid var(--c-line);
  }

  .legend ol {
    margin: var(--s-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .legend li + li {
    border-top: 1px solid var(--c-line-soft);
  }

  .legend a {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    grid-template-areas: 'idx nm go' '. meta go';
    column-gap: 8px;
    padding: 10px 0;
    text-decoration: none;
  }

  .legend .idx {
    grid-area: idx;
    font-family: var(--f-mono);
    font-size: var(--fs-mono);
    color: var(--c-text-3);
    padding-top: 4px;
    transition: color var(--dur-1) var(--ease-out);
  }

  .legend .nm {
    grid-area: nm;
    font-weight: 600;
    font-stretch: 108%;
    transition:
      font-stretch var(--dur-2) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .legend .meta {
    grid-area: meta;
    font-size: 0.8125rem;
    color: var(--c-text-3);
  }

  .legend .go {
    grid-area: go;
    align-self: center;
    color: var(--c-text-3);
    transition:
      transform var(--dur-2) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .legend a:hover .nm,
  .legend a:focus-visible .nm {
    color: var(--c-accent);
    font-stretch: 120%;
  }

  .legend a:hover .idx {
    color: var(--c-tech);
  }

  .legend a:hover .go {
    color: var(--c-accent);
    transform: translateX(4px);
  }

  /* ---------- sections */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-7);
  }

  .split-head {
    display: grid;
    align-content: start;
    gap: var(--s-4);
  }

  /* ---------- projets choisis */
  .featured {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(40px, 5vw, 72px) var(--s-6);
  }

  .feat {
    display: grid;
    align-content: start;
    gap: var(--s-5);
  }

  .feat-thumb {
    display: block;
  }

  .feat-thumb :global(.thumb) {
    transition: border-color var(--dur-1) var(--ease-out);
  }

  .feat:hover .feat-thumb :global(.thumb) {
    border-color: var(--c-accent);
  }

  .feat:hover .feat-thumb :global(img) {
    transform: scale(1.03);
  }

  .feat-body {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
  }

  .feat-title {
    font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.5rem);
    font-stretch: 120%;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .feat-title a {
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }

  .feat-title a:hover {
    color: var(--c-accent);
  }

  .feat-summary {
    color: var(--c-text-2);
    max-width: 52ch;
  }

  .feat-stack {
    font-family: var(--f-mono);
    font-size: var(--fs-mono);
    font-stretch: 87.5%;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-tech);
  }

  /* ---------- parcours */
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-5);
  }

  .step {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--s-2);
    padding-top: var(--s-4);
    border-top: 1px solid var(--c-line);
  }

  .step::before {
    content: '';
    position: absolute;
    top: -4px;
    left: 0;
    width: 7px;
    height: 7px;
    background: var(--type, var(--c-text-3));
  }

  .step-title {
    font-size: 1.125rem;
    font-stretch: 106%;
    font-weight: 600;
    line-height: 1.25;
  }

  .step-title a {
    text-decoration: none;
  }

  .step-title a:hover {
    color: var(--c-accent);
  }

  .step-org {
    font-size: var(--fs-small);
    color: var(--c-text-2);
  }

  .step-date {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: var(--s-1);
  }

  /* ---------- hors-code */
  .beyond {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6);
  }

  .b-item {
    display: grid;
    align-content: start;
    gap: var(--s-4);
  }

  .b-item h3 a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    text-decoration: none;
  }

  .b-item h3 :global(.icon) {
    font-size: 0.75em;
    color: var(--c-text-3);
    transition:
      transform var(--dur-2) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .b-item h3 a:hover {
    color: var(--c-accent);
  }

  .b-item h3 a:hover :global(.icon) {
    color: var(--c-accent);
    transform: translateX(3px);
  }

  .b-media {
    overflow: hidden;
    border: 1px solid var(--c-line);
    aspect-ratio: 3 / 2;
  }

  .b-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .b-item:hover .b-media :global(img) {
    transform: scale(1.04);
  }

  .goal-quote {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-stretch: 125%;
    font-weight: 800;
    letter-spacing: -0.04em;
    text-align: center;
    color: var(--c-text);
  }

  .b-text {
    color: var(--c-text-2);
    font-size: var(--fs-small);
  }

  .beyond-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
    margin-top: var(--s-7);
  }

  /* ---------- responsive */
  @media (max-width: 1099px) {
    .hero-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
    }

    .legend {
      max-width: 520px;
    }

    .split {
      grid-template-columns: 1fr;
    }

    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--s-7);
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 0;
    }

    .hero-grid {
      gap: var(--s-5);
      padding-top: var(--s-4);
    }

    .hero-main {
      padding-top: clamp(24px, 6vh, 64px);
    }

    .readout {
      display: none;
    }

    .highlights {
      grid-template-columns: 1fr;
    }

    .highlights > div,
    .highlights > div + div {
      padding: var(--s-3) 0;
      border-left: 0;
    }

    .highlights > div + div {
      border-top: 1px solid var(--c-line-soft);
    }

    .hint {
      display: none;
    }

    .featured {
      grid-template-columns: 1fr;
    }

    .beyond {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }

    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
