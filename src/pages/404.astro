---
/** Page 404 bilingue (servie par GitHub Pages pour toute URL inconnue). */
import Base from '~/layouts/Base.astro';
import { t } from '~/i18n/ui';
---

<Base lang="fr" title={`404 — ${t('fr', 'notfound.title')}`} description={t('fr', 'notfound.text')} alternate="/en/" noindex>
  <section class="wrap nf">
    <p class="label">404</p>
    <h1>{t('fr', 'notfound.title')}</h1>
    <p>{t('fr', 'notfound.text')} <a class="link" href="/">{t('fr', 'notfound.back')}</a></p>
    <p lang="en">{t('en', 'notfound.text')} <a class="link" href="/en/" hreflang="en">{t('en', 'notfound.back')}</a></p>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: var(--s-4);
    padding-block: var(--s-10) var(--s-8);
  }

  h1 {
    font-size: var(--fs-h2);
    letter-spacing: -0.025em;
  }

  p:not(.label) {
    max-width: var(--measure);
    color: var(--c-text-2);
  }
</style>
