---
/**
 * Gabarit commun : <head> (SEO, langues, police), en-tête avec les rubriques, pied de page avec le contact.
 */
import '@fontsource-variable/archivo/wdth.css';
import '~/styles/global.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import ExternalLink from '~/components/ui/ExternalLink.astro';
import Icon from '~/components/ui/Icon.astro';
import { t } from '~/i18n/ui';
import { ANCHORS, HOME, SECTIONS, otherLang, type Lang } from '~/i18n/routes';
import { getProfile } from '~/lib/content';
import { formatMonth } from '~/lib/format';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** URL équivalente dans l'autre langue. */
  alternate: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { lang, title, description, alternate, noindex = false, jsonLd } = Astro.props;
const profile = await getProfile();
const other = otherLang(lang);
const site = Astro.site ?? new URL('https://tulz.fr');
const canonical = new URL(Astro.url.pathname, site).href;
const alternateAbs = new URL(alternate, site).href;
const urls = lang === 'fr' ? { fr: canonical, en: alternateAbs } : { fr: alternateAbs, en: canonical };
const ogImage = new URL('/og.png', site).href;
const home = HOME[lang];
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1014" media="(prefers-color-scheme: dark)" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="fr" href={urls.fr} />
          <link rel="alternate" hreflang="en" href={urls.en} />
          <link rel="alternate" hreflang="x-default" href={urls.fr} />
        </>
      )
    }
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_US' : 'fr_FR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, 'skip')}</a>

    <header class="site-head">
      <div class="wrap head-in">
        <a class="brand" href={home}>{profile.name}</a>
        <nav class="nav" aria-label={t(lang, 'nav.label')}>
          <ul>
            {
              SECTIONS.map((section) => (
                <li>
                  <a href={`${home}#${ANCHORS[section][lang]}`} data-nav={ANCHORS[section][lang]}>
                    {t(lang, `section.${section}` as const)}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="lang" href={alternate} hreflang={other} lang={other}>{t(lang, 'lang.switch')}</a>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-foot" aria-labelledby="contact-title">
      <div class="wrap foot-in">
        <h2 class="label" id="contact-title">{t(lang, 'contact.title')}</h2>
        <a class="foot-mail" href={`mailto:${profile.email}`}>{profile.email}</a>
        <ul class="foot-links">
          <li><ExternalLink lang={lang} href={profile.links.linkedin}>LinkedIn</ExternalLink></li>
          <li><ExternalLink lang={lang} href={profile.links.github}>GitHub</ExternalLink></li>
          <li><ExternalLink lang={lang} href={profile.links.cv[lang]}>{t(lang, 'contact.cv')}</ExternalLink></li>
        </ul>
        <p class="foot-meta">
          <span>{t(lang, 'footer.updated')} {formatMonth(lang, profile.updated)}</span>
          <a class="foot-top" href="#main"><Icon name="up" />{t(lang, 'footer.top')}</a>
        </p>
      </div>
    </footer>

    <script>
      // Rubrique en cours de lecture : aria-current sur le lien de navigation (amélioration progressive).
      const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')].map((a) => [a.dataset.nav, a]));
      const sections = [...document.querySelectorAll<HTMLElement>('main section[id]')].filter((s) => links.has(s.id));
      if (sections.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              links.forEach((a) => a.removeAttribute('aria-current'));
              links.get(entry.target.id)?.setAttribute('aria-current', 'true');
            }
          },
          { rootMargin: '-35% 0px -60% 0px' },
        );
        sections.forEach((s) => io.observe(s));
      }
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: fixed;
    top: var(--s-2);
    left: var(--s-2);
    z-index: 20;
    padding: var(--s-3) var(--s-4);
    font-weight: 600;
    color: var(--c-on-accent);
    background: var(--c-accent);
    text-decoration: none;
    transform: translateY(-160%);
    transition: transform var(--dur-1) var(--ease-out);
  }

  .skip:focus {
    transform: none;
  }

  main:focus {
    outline: none;
  }

  /* ---------- en-tête */
  .site-head {
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-line);
  }

  .head-in {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand lang'
      'nav nav';
    align-items: center;
    column-gap: var(--s-5);
  }

  .brand {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .lang {
    grid-area: lang;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--s-3);
    font-size: var(--fs-meta);
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--c-line-strong);
    border-radius: 999px;
    transition:
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .lang:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  .nav {
    grid-area: nav;
    margin-inline: calc(var(--gutter) * -1);
    overflow-x: auto;
    scrollbar-width: none;
    border-top: 1px solid var(--c-line);
  }

  .nav::-webkit-scrollbar {
    display: none;
  }

  .nav ul {
    display: flex;
    gap: var(--s-5);
    width: max-content;
    padding-inline: var(--gutter);
  }

  .nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--fs-meta);
    font-weight: 500;
    color: var(--c-text-2);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }

  .nav a:hover,
  .nav a[aria-current] {
    color: var(--c-text);
  }

  .nav a[aria-current]::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--c-accent);
  }

  @media (min-width: 768px) {
    .site-head {
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .head-in {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav lang';
      height: var(--header-h);
    }

    .nav {
      margin: 0;
      border-top: 0;
      justify-self: center;
      overflow: visible;
    }

    .nav ul {
      gap: var(--s-6);
      padding: 0;
    }

    .nav a {
      min-height: var(--header-h);
    }
  }

  @media (max-width: 767.98px) {
    html {
      scroll-padding-top: var(--s-5);
    }
  }

  /* ---------- pied de page */
  .site-foot {
    margin-top: var(--s-10);
    border-top: 1px solid var(--c-text);
  }

  .foot-in {
    display: grid;
    gap: var(--s-5);
    padding-block: var(--s-8) var(--s-7);
  }

  .foot-mail {
    justify-self: start;
    font-size: var(--fs-h2);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: var(--lh-tight);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
    text-decoration-color: var(--c-accent);
    overflow-wrap: anywhere;
    transition: color var(--dur-1) var(--ease-out);
  }

  .foot-mail:hover {
    color: var(--c-accent);
  }

  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
  }

  .foot-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .foot-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3);
    margin-top: var(--s-6);
    padding-top: var(--s-5);
    border-top: 1px solid var(--c-line);
    font-size: var(--fs-meta);
    color: var(--c-text-3);
  }

  .foot-top {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--c-text-2);
    text-decoration: none;
  }

  .foot-top:hover {
    color: var(--c-accent);
  }
</style>
