---
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import ExternalLink from '~/components/ui/ExternalLink.astro';
import Todo from '~/components/ui/Todo.astro';
import { t, pageTitle, type UIKey } from '~/i18n/ui';
import { otherLang, path, type Lang } from '~/i18n/routes';
import { getJourney, getPlaces, pick } from '~/lib/content';
import { formatCoord, formatPeriod } from '~/lib/format';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const entries = await getJourney();
const places = await getPlaces();
const TYPES = ['work', 'education', 'international', 'engagement', 'sport'] as const;
const counts = Object.fromEntries(TYPES.map((ty) => [ty, entries.filter((e) => e.data.type === ty).length]));

// Regroupement par année de début (les entrées en cours restent dans leur année).
const years = [...new Set(entries.map((e) => e.data.start.slice(0, 4)))].sort((a, b) => b.localeCompare(a));
const byYear = years.map((y) => ({ year: y, items: entries.filter((e) => e.data.start.startsWith(y)) }));
---

<Base lang={lang} page="journey" title={pageTitle(lang, 'journey')} description={t(lang, 'desc.journey')} alternate={path(otherLang(lang), 'journey')}>
  <PageHeader index={3} title={pageTitle(lang, 'journey')} lead={t(lang, 'page.journey.lead')} seed="journey" />

  <section class="journey" data-journey data-label-one={lang === 'fr' ? 'étape affichée' : 'step shown'} data-label-many={lang === 'fr' ? 'étapes affichées' : 'steps shown'}>
    <div class="wrap">
      <div class="toolbar" data-requires-js>
        <div class="filters" role="group" aria-label={t(lang, 'journey.filter')}>
          <button type="button" class="filter" aria-pressed="true" data-filter="all">
            {t(lang, 'journey.all')} <span class="count">{entries.length}</span>
          </button>
          {
            TYPES.map((ty) => (
              <button type="button" class="filter" aria-pressed="false" data-filter={ty}>
                <span class:list={['swatch', `swatch--${ty}`]} aria-hidden="true" />
                {t(lang, `type.${ty}` as UIKey)} <span class="count">{counts[ty]}</span>
              </button>
            ))
          }
        </div>
        <p class="label" role="status" aria-live="polite" data-filter-status></p>
      </div>

      <div class="layout">
        <nav class="rail" aria-label={t(lang, 'journey.years')}>
          <ol role="list">
            {
              years.map((y) => (
                <li>
                  <a href={`#y${y}`} data-year-link={y}>
                    {y}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <div class="track" data-track>
          <span class="spine" aria-hidden="true"><span class="spine-fill" data-spine></span></span>
          {
            byYear.map(({ year, items }) => (
              <section class="year" id={`y${year}`} data-year={year} aria-labelledby={`yt${year}`}>
                <h2 class="year-title" id={`yt${year}`}>
                  {year}
                </h2>
                <ol class="entries" role="list">
                  {items.map((e) => {
                    const place = e.data.place ? places.get(e.data.place) : undefined;
                    return (
                      <li class:list={['entry', `entry--${e.data.type}`]} id={e.id} data-type={e.data.type} data-reveal>
                        <span class="node" aria-hidden="true" />
                        <div class="entry-head">
                          <p class="label when">
                            {e.data.current && <span class="dot dot--live" aria-hidden="true" />}
                            {formatPeriod(lang, e.data)}
                            <span class="kind">· {t(lang, `type.${e.data.type}` as UIKey)}</span>
                          </p>
                          <h3 class="entry-title">{pick(lang, e.data.title)}</h3>
                          <p class="org">
                            {e.data.org}
                            {place && <span class="place"> · {pick(lang, place.name)}</span>}
                          </p>
                        </div>
                        <div class="entry-body">
                          <p>{pick(lang, e.data.description)}</p>
                          {e.data.points && (
                            <ul class="points" role="list">
                              {e.data.points.map((pt) => (
                                <li>{pick(lang, pt)}</li>
                              ))}
                            </ul>
                          )}
                          {e.data.tags.length > 0 && (
                            <ul class="tags" role="list">
                              {e.data.tags.map((tg) => (
                                <li>{pick(lang, tg)}</li>
                              ))}
                            </ul>
                          )}
                          {e.data.links.length > 0 && (
                            <p class="links">
                              {e.data.links.map((l) => (
                                <ExternalLink lang={lang} href={l.href}>
                                  {pick(lang, l.label)}
                                </ExternalLink>
                              ))}
                            </p>
                          )}
                          {place && (
                            <p class="coord label" aria-hidden="true">
                              {formatCoord(place.lat, place.lon)}
                            </p>
                          )}
                          <Todo text={e.data.todo} />
                        </div>
                      </li>
                    );
                  })}
                </ol>
              </section>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .journey {
    --t-work: var(--c-accent);
    --t-education: var(--c-accent-2);
    --t-international: #e8edf2;
    --t-engagement: #f2c94c;
    --t-sport: #ff8a65;
    padding-block: clamp(40px, 6vw, 72px) var(--space-section);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    margin-bottom: var(--s-8);
  }

  .swatch {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sw);
  }

  .swatch--work {
    --sw: var(--t-work);
  }
  .swatch--education {
    --sw: var(--t-education);
  }
  .swatch--international {
    --sw: var(--t-international);
  }
  .swatch--engagement {
    --sw: var(--t-engagement);
  }
  .swatch--sport {
    --sw: var(--t-sport);
  }

  .filter[aria-pressed='true'] .swatch {
    background: var(--c-accent-ink);
  }

  .layout {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: var(--s-6);
  }

  /* ---------- repères d'années */
  .rail {
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }

  .rail ol {
    display: grid;
    gap: 2px;
  }

  .rail a {
    display: block;
    padding: 6px 0;
    font-family: var(--f-mono);
    font-size: var(--fs-mono-l);
    font-stretch: 87.5%;
    color: var(--c-text-3);
    text-decoration: none;
    transition:
      color var(--dur-1) var(--ease-out),
      padding var(--dur-2) var(--ease-out);
  }

  .rail a:hover {
    color: var(--c-text);
  }

  .rail a[aria-current='true'] {
    color: var(--c-accent);
    padding-left: 12px;
    box-shadow: inset 2px 0 0 var(--c-accent);
  }

  /* ---------- piste */
  .track {
    position: relative;
    padding-left: 40px;
  }

  .spine {
    position: absolute;
    left: 7px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--c-line);
  }

  .spine-fill {
    position: absolute;
    inset: 0 0 auto 0;
    height: 100%;
    background: var(--c-accent-2);
    transform-origin: top;
    transform: scaleY(var(--progress, 1));
  }

  .year + .year {
    margin-top: var(--s-8);
  }

  .year[hidden] {
    display: none;
  }

  .year-title {
    position: relative;
    margin-bottom: var(--s-5);
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 5rem);
    font-stretch: 125%;
    font-weight: 760;
    letter-spacing: -0.04em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--c-text-3);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .entries {
    display: grid;
    gap: 0;
  }

  .entry {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-3) var(--s-6);
    padding: var(--s-6) 0;
    border-top: 1px solid var(--c-line);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .entry[hidden] {
    display: none;
  }

  .entry:target {
    background: linear-gradient(90deg, var(--c-surface), transparent 80%);
  }

  .node {
    position: absolute;
    left: -38px;
    top: calc(var(--s-6) + 6px);
    width: 11px;
    height: 11px;
    background: var(--c-bg);
    border: 2px solid var(--tc);
    border-radius: 50%;
  }

  .entry--work {
    --tc: var(--t-work);
  }
  .entry--education {
    --tc: var(--t-education);
  }
  .entry--international {
    --tc: var(--t-international);
  }
  .entry--engagement {
    --tc: var(--t-engagement);
  }
  .entry--sport {
    --tc: var(--t-sport);
  }

  .entry-head {
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: var(--c-text-2);
  }

  .kind {
    color: var(--tc);
  }

  .entry-title {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    font-stretch: 112%;
    font-weight: 660;
    letter-spacing: -0.02em;
    line-height: 1.12;
  }

  .org {
    color: var(--c-text-2);
    font-size: var(--fs-small);
  }

  .place {
    color: var(--c-text-3);
  }

  .entry-body {
    display: grid;
    gap: var(--s-4);
    align-content: start;
    color: var(--c-text-2);
    max-width: 60ch;
  }

  .points {
    display: grid;
    gap: 6px;
  }

  .points li {
    position: relative;
    padding-left: 20px;
    font-size: var(--fs-small);
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 10px;
    height: 1px;
    background: var(--tc);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: var(--fs-small);
  }

  .coord {
    white-space: pre;
  }

  @media (max-width: 1099px) {
    .entry {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .rail {
      display: none;
    }

    .track {
      padding-left: 28px;
    }

    .spine {
      left: 5px;
    }

    .node {
      left: -28px;
    }
  }
</style>

<script>
  import { isMotionReduced } from '~/scripts/preferences';

  const root = document.querySelector<HTMLElement>('[data-journey]');
  if (root) {
    /* ---------- filtres par type */
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const entries = [...root.querySelectorAll<HTMLElement>('.entry')];
    const years = [...root.querySelectorAll<HTMLElement>('[data-year]')];
    const status = root.querySelector<HTMLElement>('[data-filter-status]');
    const apply = (filter: string) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
      let shown = 0;
      entries.forEach((el) => {
        const match = filter === 'all' || el.dataset.type === filter;
        el.hidden = !match;
        if (match) {
          shown++;
          el.classList.add('is-in');
        }
      });
      years.forEach((y) => (y.hidden = !y.querySelector('.entry:not([hidden])')));
      root.querySelectorAll<HTMLElement>('[data-year-link]').forEach((a) => {
        const section = root.querySelector<HTMLElement>(`[data-year="${a.dataset.yearLink}"]`);
        a.parentElement!.hidden = !!section?.hidden;
      });
      if (status) status.textContent = `${shown} ${shown > 1 ? root.dataset.labelMany : root.dataset.labelOne}`;
      progress();
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? 'all')));

    /* ---------- progression de la ligne + année courante */
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const fill = root.querySelector<HTMLElement>('[data-spine]')!;
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-year-link]')];
    let ticking = false;
    function progress() {
      ticking = false;
      if (isMotionReduced()) {
        fill.style.setProperty('--progress', '1');
      } else {
        const rect = track.getBoundingClientRect();
        const ratio = (window.innerHeight * 0.6 - rect.top) / rect.height;
        fill.style.setProperty('--progress', String(Math.max(0, Math.min(1, ratio))));
      }
      let current = years.find((y) => !y.hidden)?.dataset.year;
      for (const y of years) {
        if (!y.hidden && y.getBoundingClientRect().top < window.innerHeight * 0.4) current = y.dataset.year;
      }
      links.forEach((a) => a.setAttribute('aria-current', String(a.dataset.yearLink === current)));
    }
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(progress);
        }
      },
      { passive: true },
    );
    window.addEventListener('resize', progress);
    progress();
  }
</script>
