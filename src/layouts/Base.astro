---
/**
 * Gabarit commun : <head> (SEO, langues, polices), en-tête, pied de page, palette de commandes.
 */
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/martian-mono/standard.css';
import '~/styles/global.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import SiteHeader from '~/components/site/SiteHeader.astro';
import SiteFooter from '~/components/site/SiteFooter.astro';
import CommandPalette from '~/components/site/CommandPalette.astro';
import { t } from '~/i18n/ui';
import type { Lang, PageKey } from '~/i18n/routes';
import { getProfile } from '~/lib/content';

interface Props {
  lang: Lang;
  /** Page courante (pour la navigation), ou null pour une fiche projet / 404. */
  page: PageKey | null;
  title: string;
  description: string;
  /** URL équivalente dans l'autre langue. */
  alternate: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { lang, page, title, description, alternate, image, noindex = false, jsonLd } = Astro.props;
const profile = await getProfile();
const site = Astro.site ?? new URL('https://tulz.fr');
const canonical = new URL(Astro.url.pathname, site).href;
const alternateAbs = new URL(alternate, site).href;
const urls = lang === 'fr' ? { fr: canonical, en: alternateAbs } : { fr: alternateAbs, en: canonical };
const ogImage = new URL(image ?? '/og.png', site).href;
const fullTitle = page === 'home' ? `${profile.name} — TULZ` : `${title} — ${profile.name} · TULZ`;
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d1020" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="fr" href={urls.fr} />
          <link rel="alternate" hreflang="en" href={urls.en} />
          <link rel="alternate" hreflang="x-default" href={urls.fr} />
        </>
      )
    }
    <meta property="og:type" content={page === 'home' || page === 'about' ? 'profile' : 'website'} />
    <meta property="og:site_name" content="TULZ" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_US' : 'fr_FR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Avant le premier rendu : JavaScript disponible + préférence d'animation (système ou choix enregistré).
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let pref = null;
        try {
          pref = localStorage.getItem('tulz-motion');
        } catch (e) {}
        if (pref === 'reduced' || pref === 'full') root.dataset.motion = pref;
        const reduce = pref ? pref === 'reduced' : matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce) root.classList.add('motion-ok');
      })();
    </script>
  </head>
  <body data-page={page ?? 'other'}>
    <a class="skip" href="#main">{t(lang, 'skip')}</a>
    <SiteHeader lang={lang} current={page} alternate={alternate} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} alternate={alternate} />
    <CommandPalette lang={lang} alternate={alternate} />
    <script>
      import '~/scripts/global';
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: var(--z-skip);
    padding: 12px 16px;
    font-weight: 600;
    color: var(--c-action-ink);
    background: var(--c-action);
    text-decoration: none;
    transform: translateY(-160%);
    transition: transform var(--dur-1) var(--ease-out);
  }

  .skip:focus {
    transform: none;
  }

  main:focus {
    outline: none;
  }
</style>
