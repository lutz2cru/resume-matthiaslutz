---
/**
 * Parcours en trois parties : expérience, formation, engagements & sport.
 * Dans chaque partie, du plus récent au plus ancien ; les étapes en cours d'abord.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import ExternalLink from '~/components/ui/ExternalLink.astro';
import Icon from '~/components/ui/Icon.astro';
import Todo from '~/components/ui/Todo.astro';
import { t, pageTitle, type UIKey } from '~/i18n/ui';
import { anchor, otherLang, path, type Lang } from '~/i18n/routes';
import { JOURNEY_SECTIONS, getJourney, getPlaces, journeySection, pick, type JourneySection } from '~/lib/content';
import { formatCoord, formatPeriod } from '~/lib/format';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const entries = await getJourney();
const places = await getPlaces();
const SECTION_IDS: Record<JourneySection, Record<Lang, string>> = {
  experience: { fr: 'experience', en: 'experience' },
  education: { fr: 'formation', en: 'education' },
  engagement: { fr: 'engagements', en: 'commitments' },
};
const sections = (Object.keys(JOURNEY_SECTIONS) as JourneySection[]).map((key) => ({
  key,
  id: SECTION_IDS[key][lang],
  title: t(lang, `journey.section.${key}` as UIKey),
  items: entries.filter((e) => journeySection(e) === key),
}));

/** Liens internes complémentaires (le schéma n'accepte que des URL externes dans links). */
const more: Record<string, { href: string; label: string }> = {
  erasmus: { href: `${path(lang, 'beyond')}#${anchor(lang, 'voyages')}`, label: t(lang, 'journey.erasmus.more') },
};
const countLabel = (n: number) => `${n} ${t(lang, n > 1 ? 'journey.count.many' : 'journey.count.one')}`;
---

<Base lang={lang} page="journey" title={pageTitle(lang, 'journey')} description={t(lang, 'desc.journey')} alternate={path(otherLang(lang), 'journey')}>
  <PageHeader page="journey" title={pageTitle(lang, 'journey')} lead={t(lang, 'page.journey.lead')} seed="journey">
    <nav class="section-nav" aria-label={t(lang, 'journey.sections')}>
      <ul role="list">
        {
          sections.map((s) => (
            <li>
              <a href={`#${s.id}`}>
                {s.title}
                <span class="label">{countLabel(s.items.length)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </PageHeader>

  <div class="journey">
    {
      sections.map((s) => (
        <section class="jsec" id={s.id} aria-labelledby={`${s.id}-title`}>
          <div class="wrap">
            <header class="row-head jsec-head">
              <h2 class="h2" id={`${s.id}-title`}>
                {s.title}
              </h2>
              <p class="label">{countLabel(s.items.length)}</p>
            </header>
            <ol class="entries" role="list">
              {s.items.map((e) => {
                const place = e.data.place ? places.get(e.data.place) : undefined;
                const extra = more[e.id];
                return (
                  <li class="entry" id={e.id} data-current={e.data.current || undefined} style={`--tc: var(--c-type-${e.data.type})`} data-reveal>
                    <span class="node" aria-hidden="true" />
                    <p class="when label">
                      {e.data.current && <span class="dot dot--live" aria-hidden="true" />}
                      {formatPeriod(lang, e.data)}
                    </p>
                    <div class="entry-head">
                      <h3 class="entry-title">{pick(lang, e.data.title)}</h3>
                      <p class="org">
                        {e.data.org}
                        {place && <span class="place"> · {pick(lang, place.name)}</span>}
                      </p>
                      <p class="kind label">{t(lang, `type.${e.data.type}` as UIKey)}</p>
                    </div>
                    <div class="entry-body">
                      <p>{pick(lang, e.data.description)}</p>
                      {e.data.points && (
                        <ul class="points" role="list">
                          {e.data.points.map((pt) => (
                            <li>{pick(lang, pt)}</li>
                          ))}
                        </ul>
                      )}
                      {e.data.tags.length > 0 && (
                        <ul class="tags" role="list">
                          {e.data.tags.map((tg) => (
                            <li>{pick(lang, tg)}</li>
                          ))}
                        </ul>
                      )}
                      {(e.data.links.length > 0 || extra) && (
                        <p class="links">
                          {extra && (
                            <a class="link" href={extra.href}>
                              {extra.label}
                              <span class="arrow">
                                <Icon name="arrow" />
                              </span>
                            </a>
                          )}
                          {e.data.links.map((l) => (
                            <ExternalLink lang={lang} href={l.href}>
                              {pick(lang, l.label)}
                            </ExternalLink>
                          ))}
                        </p>
                      )}
                      {place && (
                        <p class="coord label" aria-hidden="true">
                          {formatCoord(place.lat, place.lon)}
                        </p>
                      )}
                      <Todo text={e.data.todo} />
                    </div>
                  </li>
                );
              })}
            </ol>
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  /* ---------- parties */
  .journey {
    padding-bottom: var(--space-section);
  }

  .jsec {
    padding-top: clamp(56px, 7vw, 104px);
  }

  .jsec-head {
    margin-bottom: var(--s-6);
  }

  /* ---------- étapes */
  .entries {
    position: relative;
    padding-left: 32px;
  }

  /* Ligne du parcours : l'un des rares dégradés identitaires. */
  .entries::before {
    content: '';
    position: absolute;
    left: 5px;
    top: var(--s-6);
    bottom: var(--s-6);
    width: 1px;
    background: var(--grad-brand-v);
    opacity: 0.8;
  }

  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 150px minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-3) var(--s-6);
    padding: var(--s-6) 0;
    border-top: 1px solid var(--c-line);
  }

  .entry:target {
    background: var(--c-surface);
  }

  .node {
    position: absolute;
    left: -32px;
    top: calc(var(--s-6) + 5px);
    width: 11px;
    height: 11px;
    background: var(--c-bg);
    border: 2px solid var(--tc);
    border-radius: 50%;
  }

  .entry[data-current] .node {
    background: var(--tc);
  }

  .when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: start;
    gap: 8px;
    padding-top: 6px;
    color: var(--c-text-2);
  }

  .entry-head {
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .entry-title {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    font-stretch: 112%;
    font-weight: 660;
    letter-spacing: -0.02em;
    line-height: 1.12;
  }

  .org {
    color: var(--c-text);
    font-size: var(--fs-small);
  }

  .place {
    color: var(--c-text-2);
  }

  .kind {
    color: var(--tc);
  }

  .entry-body {
    display: grid;
    gap: var(--s-4);
    align-content: start;
    color: var(--c-text-2);
    max-width: 60ch;
  }

  .points {
    display: grid;
    gap: 6px;
  }

  .points li {
    position: relative;
    padding-left: 20px;
    font-size: var(--fs-small);
    color: var(--c-text);
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 10px;
    height: 1px;
    background: var(--tc);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: var(--fs-small);
  }

  .coord {
    white-space: pre;
  }

  @media (max-width: 1099px) {
    .entry {
      grid-template-columns: 130px minmax(0, 1fr);
    }

    .entry-body {
      grid-column: 2;
    }
  }

  @media (max-width: 760px) {
    .entries {
      padding-left: 26px;
    }

    .entry {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-3);
    }

    .node {
      left: -26px;
    }

    .entry-head {
      order: 1;
    }

    .when {
      order: 2;
      padding-top: 0;
    }

    .entry-body {
      order: 3;
      grid-column: auto;
    }
  }
</style>
