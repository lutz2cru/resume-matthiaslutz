---
/** Fond génératif (voir src/scripts/terrain-canvas.ts). Décoratif : masqué aux lecteurs d'écran. */
interface Props {
  id: string;
  variant?: 'hero' | 'band';
  seed?: string;
  class?: string;
}

const { id, variant = 'band', seed = 'tulz', class: className } = Astro.props;
---

<div id={id} class:list={['terrain', `terrain--${variant}`, 'dotgrid', className]} data-terrain data-variant={variant} data-seed={seed} aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  .terrain {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    transition: background-color var(--dur-3) var(--ease-out);
  }

  .terrain canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }

  .terrain:global(.is-live) {
    background-image: none;
  }

  .terrain:global(.is-live) canvas {
    opacity: 1;
  }

  .terrain--band {
    -webkit-mask-image: linear-gradient(to bottom, #000 30%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 30%, transparent 100%);
  }

  .terrain--hero {
    -webkit-mask-image: radial-gradient(130% 100% at 60% 40%, #000 55%, transparent 100%);
    mask-image: radial-gradient(130% 100% at 60% 40%, #000 55%, transparent 100%);
  }
</style>
