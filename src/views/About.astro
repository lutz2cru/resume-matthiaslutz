---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import ExternalLink from '~/components/ui/ExternalLink.astro';
import NowList from '~/components/blocks/NowList.astro';
import { t, pageTitle } from '~/i18n/ui';
import { otherLang, path, type Lang } from '~/i18n/routes';
import { getProfile, pick } from '~/lib/content';
import { formatUpdated } from '~/lib/format';
import { personJsonLd } from '~/lib/seo';
import portrait from '~/assets/images/portrait-matthias.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const profile = await getProfile();
---

<Base lang={lang} page="about" title={pageTitle(lang, 'about')} description={t(lang, 'desc.about')} alternate={path(otherLang(lang), 'about')} jsonLd={personJsonLd(lang, profile)}>
  <PageHeader index={1} title={pageTitle(lang, 'about')} lead={t(lang, 'page.about.lead')} seed="about" />

  <section class="section intro">
    <div class="wrap grid">
      <figure class="portrait" data-reveal>
        <div class="frame">
          <Image src={portrait} alt={t(lang, 'about.portrait')} widths={[360, 560, 760]} sizes="(min-width: 900px) 30vw, 80vw" loading="eager" />
          <span class="corner corner--tl" aria-hidden="true"></span>
          <span class="corner corner--br" aria-hidden="true"></span>
        </div>
        <figcaption class="label">{profile.name} · {pick(lang, profile.role)}</figcaption>
      </figure>

      <div class="bio">
        <p class="bio-lead" data-reveal>{pick(lang, profile.bio[0]!)}</p>
        <div class="prose" data-reveal>
          {profile.bio.slice(1).map((p) => <p>{pick(lang, p)}</p>)}
        </div>
        <p class="links" data-reveal>
          <ExternalLink lang={lang} href={pick(lang, profile.links.cv)}>{t(lang, 'about.cv')}</ExternalLink>
          <ExternalLink lang={lang} href={profile.links.linkedin}>LinkedIn</ExternalLink>
          <ExternalLink lang={lang} href={profile.links.github}>GitHub</ExternalLink>
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="now-title">
    <div class="wrap split">
      <header class="split-head" data-reveal>
        <h2 id="now-title" class="h2">{t(lang, 'about.now')}</h2>
        <p class="label">{t(lang, 'home.updated')} {formatUpdated(lang, profile.updated)}</p>
      </header>
      <NowList lang={lang} />
    </div>
  </section>

  <section class="section" aria-labelledby="facts-title">
    <div class="wrap split">
      <h2 id="facts-title" class="h2" data-reveal>{t(lang, 'about.facts')}</h2>
      <div class="facts-col">
        <dl class="facts" data-reveal-group>
          {
            profile.facts.map((f) => (
              <div data-reveal>
                <dt class="label">{pick(lang, f.label)}</dt>
                <dd>{pick(lang, f.value)}</dd>
              </div>
            ))
          }
        </dl>
        <h3 class="label lang-title">{t(lang, 'about.languages')}</h3>
        <ul class="langs" role="list">
          {
            profile.languages.map((l) => (
              <li>
                <span>{pick(lang, l.label)}</span>
                <span class="label">{pick(lang, l.level)}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-8);
    align-items: start;
  }

  .portrait {
    display: grid;
    gap: var(--s-3);
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }

  .frame {
    position: relative;
    padding: 12px;
    border: 1px solid var(--c-line);
    background: var(--c-bg-deep);
  }

  .frame :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    filter: saturate(0.9) contrast(1.03);
  }

  .corner {
    position: absolute;
    width: 22px;
    height: 22px;
    border-color: var(--c-accent);
    border-style: solid;
  }

  .corner--tl {
    top: -1px;
    left: -1px;
    border-width: 2px 0 0 2px;
  }

  .corner--br {
    bottom: -1px;
    right: -1px;
    border-width: 0 2px 2px 0;
  }

  .bio {
    display: grid;
    gap: var(--s-6);
  }

  .bio-lead {
    font-size: clamp(1.25rem, 1.02rem + 0.85vw, 1.75rem);
    font-stretch: 104%;
    font-weight: 450;
    line-height: 1.38;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .prose {
    font-size: 1.125rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-7);
  }

  .split-head {
    display: grid;
    align-content: start;
    gap: var(--s-4);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--c-line);
  }

  .facts div {
    display: grid;
    gap: 6px;
    padding: 18px 16px 18px 0;
    border-bottom: 1px solid var(--c-line);
  }

  .facts dd {
    font-size: 1.125rem;
    font-stretch: 108%;
    font-weight: 560;
  }

  .lang-title {
    margin-top: var(--s-7);
    margin-bottom: var(--s-3);
  }

  .langs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--c-line);
  }

  .langs li {
    display: grid;
    gap: 4px;
    padding: 14px 12px 14px 0;
    font-weight: 560;
  }

  @media (max-width: 900px) {
    .grid,
    .split {
      grid-template-columns: 1fr;
    }

    .portrait {
      position: static;
      max-width: 420px;
    }
  }

  @media (max-width: 480px) {
    .facts,
    .langs {
      grid-template-columns: 1fr;
    }
  }
</style>
