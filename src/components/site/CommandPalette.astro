---
/**
 * Palette de commandes (Ctrl/⌘ K ou /). Dialogue natif <dialog> + combobox ARIA.
 * Les entrées sont calculées au build et embarquées en JSON ; le script vit dans src/scripts/palette.ts.
 */
import { t, pageTitle } from '~/i18n/ui';
import { PAGES, otherLang, projectPath, type Lang, type PageKey } from '~/i18n/routes';
import { getProfile, getProjects, pick } from '~/lib/content';

interface Props {
  lang: Lang;
  alternate: string;
}

const { lang, alternate } = Astro.props;
const profile = await getProfile();
const projects = await getProjects();

type Item = { id: string; group: 'pages' | 'projects' | 'actions'; label: string; hint?: string; href?: string; action?: string; keywords?: string };

const pageKeys = Object.keys(PAGES) as PageKey[];
const items: Item[] = [
  ...pageKeys.map((key) => ({ id: `page-${key}`, group: 'pages' as const, label: pageTitle(lang, key), href: PAGES[key][lang], keywords: key })),
  ...projects.map((p) => ({
    id: `project-${p.id}`,
    group: 'projects' as const,
    label: pick(lang, p.data.title),
    hint: p.data.year ?? '',
    href: p.data.kind === 'case' ? projectPath(lang, p.id) : `${PAGES.projects[lang]}#note-${p.id}`,
    keywords: [...p.data.stack, ...p.data.extra, ...p.data.domains].join(' '),
  })),
  { id: 'action-copy', group: 'actions', label: t(lang, 'palette.action.copy'), hint: profile.email, action: 'copy-email', keywords: 'mail email contact' },
  { id: 'action-lang', group: 'actions', label: t(lang, 'palette.action.lang'), hint: otherLang(lang).toUpperCase(), href: alternate, keywords: 'langue language english français' },
  { id: 'action-motion', group: 'actions', label: t(lang, 'palette.action.motion'), action: 'toggle-motion', keywords: 'motion animation mouvement' },
  { id: 'action-top', group: 'actions', label: t(lang, 'palette.action.top'), action: 'top', keywords: 'top haut' },
];

const data = {
  email: profile.email,
  groups: {
    pages: t(lang, 'palette.group.pages'),
    projects: t(lang, 'palette.group.projects'),
    actions: t(lang, 'palette.group.actions'),
  },
  empty: t(lang, 'palette.empty'),
  copied: t(lang, 'contact.copied'),
  items,
};
---

<dialog id="palette" class="palette" aria-labelledby="palette-title">
  <div class="panel">
    <h2 id="palette-title" class="sr-only">{t(lang, 'palette.title')}</h2>
    <div class="search">
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="7" cy="7" r="4.6" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="m10.4 10.4 3.6 3.6" stroke="currentColor" stroke-width="1.5"></path></svg>
      <input
        id="palette-input"
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
        autocomplete="off"
        spellcheck="false"
        placeholder={t(lang, 'palette.placeholder')}
        aria-label={t(lang, 'palette.title')}
      />
      <button type="button" class="esc kbd" data-palette-close>Esc</button>
    </div>
    <ul id="palette-list" role="listbox" aria-label={t(lang, 'palette.title')}></ul>
    <p class="status" role="status" aria-live="polite"></p>
    <div class="foot mono" aria-hidden="true">
      <span><span class="kbd">↑</span><span class="kbd">↓</span> {t(lang, 'palette.hint.nav')}</span>
      <span><span class="kbd">↵</span> {t(lang, 'palette.hint.open')}</span>
      <span><span class="kbd">Esc</span> {t(lang, 'palette.hint.close')}</span>
    </div>
  </div>
  <script type="application/json" id="palette-data" set:html={JSON.stringify(data)} />
</dialog>

<style>
  .palette {
    width: min(640px, calc(100vw - 24px));
    max-height: min(560px, calc(100dvh - 120px));
    margin: 12vh auto auto;
    padding: 0;
    color: var(--c-text);
    background: var(--c-bg-deep);
    border: 1px solid var(--c-line);
    box-shadow: 0 40px 120px rgb(0 0 0 / 0.55);
    overflow: hidden;
  }

  .palette::backdrop {
    background: rgb(8 10 13 / 0.72);
    backdrop-filter: blur(3px);
  }

  .palette[open] {
    display: flex;
  }

  :global(html.motion-ok) .palette[open] {
    animation: palette-in var(--dur-2) var(--ease-out);
  }

  @keyframes palette-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.985);
    }
  }

  .panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
    border-bottom: 1px solid var(--c-line);
    color: var(--c-text-3);
  }

  .search input {
    flex: 1;
    min-width: 0;
    height: 60px;
    font-size: 1.0625rem;
    font-stretch: 105%;
    background: transparent;
    border: 0;
    outline: none;
    color: var(--c-text);
  }

  .search input::placeholder {
    color: var(--c-text-3);
  }

  .esc {
    cursor: pointer;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 8px;
    overflow-y: auto;
    flex: 1;
    min-height: 0;
  }

  ul :global(.group) {
    padding: 14px 10px 6px;
    font-family: var(--f-mono);
    font-size: var(--fs-mono);
    font-stretch: 87.5%;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-text-3);
  }

  ul :global([role='option']) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 12px;
    font-size: var(--fs-small);
    color: var(--c-text-2);
    cursor: pointer;
    border-left: 2px solid transparent;
  }

  ul :global([role='option'] .hint) {
    font-family: var(--f-mono);
    font-size: var(--fs-mono);
    font-stretch: 87.5%;
    color: var(--c-text-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  ul :global([role='option'][aria-selected='true']) {
    color: var(--c-text);
    background: var(--c-surface);
    border-left-color: var(--c-accent);
  }

  ul :global(mark) {
    background: none;
    color: var(--c-accent);
  }

  .status {
    padding: 0 20px;
    font-size: var(--fs-small);
    color: var(--c-text-3);
  }

  .status:not(:empty) {
    padding-block: 14px;
  }

  .foot {
    display: flex;
    gap: 18px;
    padding: 10px 16px;
    border-top: 1px solid var(--c-line);
  }

  .foot > span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  @media (max-width: 560px) {
    .palette {
      margin-top: 72px;
    }

    .foot {
      display: none;
    }
  }
</style>
